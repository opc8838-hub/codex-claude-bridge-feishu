# One repo, three Feishu bots. Each process picks one agent.
#   CTI_AGENT=claude | codex | grok
CTI_AGENT=grok

# Default working directory
# CTI_DEFAULT_WORKDIR=C:\Users\me\projects
CTI_DEFAULT_WORKDIR=/path/to/your/project

# Optional default model
# CTI_DEFAULT_MODEL=grok-4.6

CTI_DEFAULT_MODE=code

# Optional CLI paths
# CTI_GROK_EXECUTABLE=C:\Users\me\.grok\bin\grok.exe
# CTI_CODEX_EXECUTABLE=/path/to/codex
# CTI_CLAUDE_CODE_EXECUTABLE=/path/to/claude

# Claude (when CTI_AGENT=claude)
# ANTHROPIC_AUTH_TOKEN=sk-xxx
# ANTHROPIC_BASE_URL=https://api.deepseek.com/anthropic

# Codex (when CTI_AGENT=codex)
# OPENAI_API_KEY=sk-xxx
# OPENAI_BASE_URL=https://your-api-provider.com/v1

# Grok uses `grok login` → ~/.grok/auth.json

# Feishu — use a DIFFERENT app (bot) per agent process
CTI_FEISHU_APP_ID=your-app-id
CTI_FEISHU_APP_SECRET=your-app-secret
CTI_FEISHU_DOMAIN=feishu
CTI_FEISHU_REQUIRE_MENTION=true

# Grok/Claude: false recommended. Codex: often true
CTI_AUTO_APPROVE=false
