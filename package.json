{
  "name": "codex-claude-bridge-feishu",
  "version": "1.1.0",
  "description": "Feishu/Lark bridge for Claude Code, OpenAI Codex, and Grok — three bots, one repo",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/opc8838-hub/codex-claude-bridge-feishu"
  },
  "bin": {
    "codex-bridge": "bin/cli.js",
    "claude-bridge": "bin/cli.js",
    "grok-bridge": "bin/cli.js"
  },
  "files": [
    "bin/",
    "dist/",
    "vitest.config.ts",
    "ecosystem.config.cjs",
    "scripts/build.js",
    "scripts/codex-hidden-launcher.cs",
    "src/",
    "tsconfig.json",
    "README.md",
    "README.zh.md",
    "LICENSE"
  ],
  "keywords": [
    "claude-code",
    "codex",
    "grok",
    "openai",
    "anthropic",
    "feishu",
    "lark",
    "chatbot",
    "ai-coding",
    "bridge",
    "ai-agent"
  ],
  "scripts": {
    "build": "node scripts/build.js",
    "start": "node dist/daemon.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/main.ts",
    "prepublishOnly": "npm run build && npm test"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.2.62",
    "@larksuiteoapi/node-sdk": "^1.60.0",
    "@openai/codex-sdk": "^0.130.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
